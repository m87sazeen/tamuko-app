# SMS OTP provider: dev (free, local, no real SMS) | textbelt (free 1 SMS/day with key "textbelt")
EXPO_PUBLIC_SMS_PROVIDER=dev
EXPO_PUBLIC_TEXTBELT_KEY=textbelt

# Google sign-in (free OAuth client IDs from Google Cloud Console). Public client IDs only — never secrets.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
