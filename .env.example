# Sign-in options — all free. Leave a section empty to hide that option in the app.
# "This device" sign-in (no account) is always available.

# One-time codes by SMS or WhatsApp through your own self-hosted gateway (see server/README.md).
EXPO_PUBLIC_OTP_GATEWAY_URL=
# Optional override: dev (codes shown in-app, testing only) | gateway | textbelt
# EXPO_PUBLIC_SMS_PROVIDER=gateway

# Sign in with Google — free OAuth client IDs from Google Cloud Console. Public IDs only, never secrets.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Sign in with LINE — free LINE Login channel ID (the secret goes in server/.env, not here).
EXPO_PUBLIC_LINE_CHANNEL_ID=
