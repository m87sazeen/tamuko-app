# tamuko sign-in gateway — copy to .env and fill in what you use. Everything here is free.
PORT=8787
# Comma-separated web origins allowed to call the gateway (apps on phones don't need this).
ALLOWED_ORIGINS=http://localhost:8081
# Long random string; signs the "verified" receipts returned to the app. Generate: openssl rand -hex 32
SESSION_SECRET=

# --- SMS from your own Android phone (free: uses your mobile plan) -----------------------------
# Install "SMS Gateway for Android" (open source, github.com/capcom6/android-sms-gateway) on a spare phone.
# Local server mode:   SMS_GATEWAY_URL=http://<phone-ip>:8080
# Free cloud relay:    SMS_GATEWAY_URL=https://api.sms-gate.app/3rdparty/v1
SMS_GATEWAY_URL=
SMS_GATEWAY_USER=
SMS_GATEWAY_PASS=

# --- WhatsApp (free, UNOFFICIAL — breaks WhatsApp's terms; the number can be banned) ---------
# 1 = link a WhatsApp number on first start by scanning the QR shown in this terminal.
WHATSAPP_ENABLED=0

# --- Sign in with LINE (free, official) ---------------------------------------------------------
# developers.line.biz → create a LINE Login channel; add the app's callback URL (see README).
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
